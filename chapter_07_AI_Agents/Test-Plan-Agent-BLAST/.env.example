# Test Plan Agent — copy to .env and fill in. NEVER commit .env.

# --- Jira Cloud (read-only service account) ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=service-account@your-org.com
JIRA_API_TOKEN=                      # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_AC_FIELD_ID=                    # optional: customfield_XXXXX. Leave blank to auto-discover.

# --- Groq (LLM) ---
GROQ_API_KEY=                        # https://console.groq.com/keys
MODEL=openai/gpt-oss-120b            # the one call + repair
MODEL_SMALL=openai/gpt-oss-20b       # budget.py comment summariser only
REASONING_EFFORT=medium             # low | medium | high  (high blows the free-tier 8k tok/min limit)
MAX_COMPLETION_TOKENS=8000           # keep prompt+completion under Groq free-tier 8000 tok/min

# --- behaviour ---
DATA_POLICY=standard                 # standard | redacted | zdr  (zdr fails: Groq has no ZDR endpoint)
MODEL_INPUT_LIMIT=40000              # token budget for IssueContext before budget.py trims
SEED=7                               # fixed decoding seed for reproducibility
HTTP_TIMEOUT=30
RAW_CACHE_TTL_HOURS=24

# Free Groq tier = 8000 tokens/minute, 1000 requests/day. A run makes 1 model call
# (+1 on validation failure); ~1 run/minute is sustainable. For high effort / faster
# throughput, upgrade at console.groq.com/settings/billing.
